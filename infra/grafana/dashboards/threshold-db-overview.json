{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Dashboard contract",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Per-DB MVP dashboard for CloudNativePG/PostgreSQL. Slow-query panels need pg_stat_statements/exporter support; until then they are intentionally empty instead of faking data."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active connections",
      "description": "Open PostgreSQL backends/connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname, pod) (cnpg_backends_total{namespace=\"$db_namespace\"}) or sum by (datname, pod) (pg_stat_database_numbackends{namespace=\"$db_namespace\"})",
          "legendFormat": "{{datname}} {{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transactions",
      "description": "Commit + rollback throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_commit{namespace=\"$db_namespace\"}[5m]) + rate(cnpg_pg_stat_database_xact_rollback{namespace=\"$db_namespace\"}[5m])) or sum by (datname) (rate(pg_stat_database_xact_commit{namespace=\"$db_namespace\"}[5m]) + rate(pg_stat_database_xact_rollback{namespace=\"$db_namespace\"}[5m]))",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rollback rate",
      "description": "Rollback throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_rollback{namespace=\"$db_namespace\"}[5m])) or sum by (datname) (rate(pg_stat_database_xact_rollback{namespace=\"$db_namespace\"}[5m]))",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "WAL generated",
      "description": "WAL byte rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(cnpg_pg_stat_wal_wal_bytes{namespace=\"$db_namespace\"}[5m])) or sum by (pod) (rate(pg_stat_wal_wal_bytes{namespace=\"$db_namespace\"}[5m]))",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Slow queries (pg_stat_statements)",
      "description": "Requires pg_stat_statements metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (datname, queryid) (rate(pg_stat_statements_total_time_seconds{namespace=\"$db_namespace\"}[5m])))",
          "legendFormat": "{{datname}} {{queryid}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PostgreSQL/CNPG warning/error logs",
      "description": "Database log anomalies.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (count_over_time({namespace=\"$db_namespace\"} |~ \"(?i)(error|fatal|panic|slow|deadlock|checkpoint)\" [5m]))",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Replication lag",
      "description": "Replica lag when replicas exist.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (cnpg_pg_replication_lag_seconds{namespace=\"$db_namespace\"}) or max by (pod) (pg_replication_lag_seconds{namespace=\"$db_namespace\"})",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "threshold",
    "mvp",
    "postgres",
    "cnpg",
    "database"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Mimir",
          "value": "Mimir"
        },
        "label": "Metrics datasource",
        "hide": 0
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "Loki"
        },
        "label": "Logs datasource",
        "hide": 0
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "current": {
          "text": "threshold",
          "value": "threshold"
        },
        "includeAll": false,
        "refresh": 1
      },
      {
        "name": "db_namespace",
        "type": "constant",
        "query": "default",
        "current": {
          "text": "default",
          "value": "default"
        },
        "label": "DB namespace"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Threshold / DB overview",
  "uid": "threshold-db-overview",
  "version": 1,
  "weekStart": ""
}
